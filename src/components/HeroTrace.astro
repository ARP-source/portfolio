---
// Static SVG of real recordings, one clip per gesture the hero hand performs. It is the hero with JS
// off or no WebGL, and the shape the particle `trace` formation follows.
import trace from '../data/hero-trace.json';
import { tracePlayback } from '../tokens/tokens';
const W = 1200, H = 220, MID = H / 2, AMP = H * 0.44;
// The clips play end to end and loop. The tape is the whole loop plus its first clip again, so the
// window (one clip wide) never runs off the end; CSS slides it left one loop per --trace-period.
const clips = trace.clips;
const per = clips[0]!.points.length;
const loop = clips.flatMap((c) => c.points);
const tape = [...loop, ...loop.slice(0, per + 1)];
const step = W / per;
const d = tape.map((v, i) => `${i ? 'L' : 'M'}${(i * step).toFixed(1)} ${(MID - v * AMP).toFixed(1)}`).join('');
const shift = W * clips.length;
// With reduced motion the tape stands still on this clip (and the hand holds this gesture).
const still = clips.findIndex((c) => c.key === 'open');
const names = clips.map((c) => c.name.toLowerCase());
const ms = Math.round(parseFloat(trace.window.split('-')[1]!) * 1000 - parseFloat(trace.window) * 1000);
---

<figure class="hero-trace" style={`--tape-shift:-${shift}px;--tape-still:-${still * W}px`}>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <line class="baseline" x1="0" x2={W} y1={MID} y2={MID}></line>
    <g class="tape"><path class="trace" d={d}></path></g>
  </svg>
  <figcaption>
    <span class="gesture" aria-hidden="true">
      {clips.map((c, k) => (
        <span style={`--k:${k}`} data-still={k === still ? '' : undefined}>{c.name}</span>
      ))}
    </span>
    Forearm EMG from participant 1 on day 1 of the GRABMyo dataset, {ms} ms of each gesture, all on one scale.
    <span class="sr-only">
      The recording cycles through {names.slice(0, -1).join(', ')} and {names.at(-1)}, and the hand beside it
      performs each one as it plays. Electrode pair {trace.channel.replace('forearm bipolar pair ', '')}, {trace.filter}.
    </span>
  </figcaption>
</figure>

<style define:vars={{ clip: `${tracePlayback.clipS}s` }}>
  .hero-trace { margin: 0; }
  svg { display: block; width: 100%; height: clamp(5rem, 12vw, 9rem); overflow: hidden; }
  .tape { animation: tape var(--trace-period) linear infinite; }
  @keyframes tape { to { transform: translateX(var(--tape-shift)); } }
  .baseline { stroke: var(--tissue); stroke-width: 1; vector-effect: non-scaling-stroke; }
  figcaption { margin-top: 0.75rem; font-size: 0.85rem; color: var(--ink-dim); }
  /* The gesture whose clip is entering at the right edge, which is the one the hand is making. */
  .gesture { display: grid; justify-items: start; color: var(--ink); }
  .gesture > span { grid-area: 1 / 1; opacity: 0; animation: gesture var(--trace-period) linear infinite; animation-delay: calc((var(--k) - 1) * var(--clip)); }
  @keyframes gesture { 0% { opacity: 0; } 1.5%, 19% { opacity: 1; } 20%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .tape { animation: none; transform: translateX(var(--tape-still)); }
    .gesture > span { animation: none; }
    .gesture > [data-still] { opacity: 1; }
  }
</style>
