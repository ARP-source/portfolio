---
// Placeholder until photos arrive. Swap for <Picture> (astro:assets) with AVIF/WebP, explicit size, lazy loading.
interface Props { caption: string; ratio?: string }
const { caption, ratio = '4 / 3' } = Astro.props;
---

<figure class="slot">
  <div class="frame" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Photo placeholder: ${caption}`}>
    <span class="meta">TODO(anuraag): photo</span>
  </div>
  <figcaption class="meta">{caption}</figcaption>
</figure>

<style>
  .slot { margin: 0; }
  .frame {
    border: 1px dashed var(--tissue);
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(0deg, transparent 0 23px, color-mix(in srgb, var(--tissue-faint) 40%, transparent) 23px 24px);
  }
  figcaption { margin-top: 0.5rem; }
</style>
