---
import type { CollectionEntry } from 'astro:content';
import KeyMetric from './KeyMetric.astro';
import Sparkline from './Sparkline.astro';
interface Props { project: CollectionEntry<'projects'>; index: number }
const { project, index } = Astro.props;
const p = project.data;
const statusLabel = { shipped: 'shipped', 'in-progress': 'in progress', prototype: 'prototype' }[p.status];
---

<article class="card" aria-labelledby={`card-${project.id}`}>
  <p class="meta head">
    <span>{String(index + 1).padStart(2, '0')}</span>
    <span class={`status status--${p.status}`}>{statusLabel}</span>
  </p>
  <h3 id={`card-${project.id}`}><a href={`/work/${project.id}`}>{p.title}</a></h3>
  <p class="one">{p.oneLiner}</p>
  <div class="signal-row" data-thread-target={project.id}>
    {p.sparkline && <Sparkline slug={project.id} {...p.sparkline} />}
    {p.keyMetric && <KeyMetric metric={p.keyMetric} />}
    {
      !p.keyMetric && !p.sparkline && (
        <p class="meta">No headline number yet: see the notebook page for what is and isn't measured.</p>
      )
    }
  </div>
  <p class="meta stack">{p.stack.join(' · ')}</p>
</article>

<style>
  .card { padding-block: 2rem; border-top: 1px solid var(--olive-deep); display: grid; gap: 0.75rem; }
  .head { display: flex; gap: 1rem; margin: 0; }
  .status--in-progress { color: var(--olive-bright); }
  .status--shipped { color: var(--bronze); }
  h3 { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); }
  h3 a { color: var(--bone); text-decoration: none; }
  h3 a:hover { color: var(--bronze-bright); }
  h3 a::after { content: ' →'; color: var(--bronze); font-family: var(--font-mono); font-size: 0.6em; }
  .one { max-width: 38rem; color: var(--bone-dim); margin: 0; }
  .signal-row { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; align-items: flex-end; margin-top: 0.5rem; }
  .stack { margin: 0; }
</style>
