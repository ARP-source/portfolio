    <PhotoSlot caption="BattleBots, De Anza: club president" />
    <PhotoSlot caption="FIRST Robotics" />
  </div>
</section>

<style>
  .photos { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 16rem)); gap: 1.5rem; margin-top: 2rem; }
