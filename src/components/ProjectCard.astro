---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; index: number }
const { project } = Astro.props;
const p = project.data;
const status = { shipped: '', 'in-progress': 'in progress', prototype: 'prototype' }[p.status];
// Dates may still carry a TODO; the card shows only the finished part.
const when = p.dates.split('·')[0]!.trim();
const km = p.keyMetric;
const result = km ? `${km.label[0]!.toUpperCase()}${km.label.slice(1)}: ${km.value}${km.unit ? ` ${km.unit}` : ''}` : '';
---

<article class="card" aria-labelledby={`card-${project.id}`} data-thread-target={project.id}>
  <div class="top">
    <h3 id={`card-${project.id}`}><a href={`/work/${project.id}`}>{p.title}</a></h3>
    <p class="when">{when}{status && <>, {status}</>}</p>
  </div>
  <p class="one">{p.oneLiner}</p>
  {result && <p class="result">{result}</p>}
  <p class="more">
    <a href={`/work/${project.id}`}>Write-up</a>
    {p.links.repo && <a href={p.links.repo}>Code</a>}
    {p.links.demo && <a href={p.links.demo}>Live</a>}
  </p>
</article>

<style>
  .card { padding-block: 1.5rem; border-top: 1px solid var(--tissue-faint); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1.5rem; }
  h3 { font-size: 1.45rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .when { margin: 0; color: var(--ink-dim); font-size: 0.95rem; }
  .one { max-width: 40rem; color: var(--ink-dim); margin: 0.5rem 0 0; }
  .result { margin: 0.5rem 0 0; font-size: 0.95rem; }
  .more { display: flex; gap: 1.25rem; margin: 0.75rem 0 0; font-size: 0.95rem; }
  .more a { padding-block: 0.25rem; }
</style>
