---
// Static SVG of one real recording. It is the hero with JS off or no WebGL, and the
// shape the particle `trace` formation will match in Phase 3.
import trace from '../data/hero-trace.json';
const W = 1200, H = 220, MID = H / 2, AMP = H * 0.44;
// The recording plays forward then backward, so the loop has no seam. The tape is that loop twice
// (4 widths); CSS slides it left by one loop per --trace-period. The particle trace reads the same clock.
const pts = trace.points;
const n = pts.length;
const loop = [...pts, ...pts.slice(1, -1).reverse()];
const tape = [...loop, ...loop, pts[0]!];
const step = W / (n - 1);
const d = tape.map((v, i) => `${i ? 'L' : 'M'}${(i * step).toFixed(1)} ${(MID - v * AMP).toFixed(1)}`).join('');
---

<figure class="hero-trace">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <line class="baseline" x1="0" x2={W} y1={MID} y2={MID}></line>
    <g class="tape"><path class="trace" d={d}></path></g>
  </svg>
  <figcaption>
    Forearm EMG during a wrist flexion, 750 ms. GRABMyo dataset, participant 1, day 1.<span class="sr-only"> {trace.channel}, {trace.filter}.</span>
  </figcaption>
</figure>

<style>
  .hero-trace { margin: 0; }
  svg { display: block; width: 100%; height: clamp(5rem, 12vw, 9rem); overflow: hidden; }
  .tape { animation: tape var(--trace-period) linear infinite; }
  @keyframes tape { to { transform: translateX(-2400px); } }
  @media (prefers-reduced-motion: reduce) { .tape { animation: none; } }
  .baseline { stroke: var(--tissue); stroke-width: 1; vector-effect: non-scaling-stroke; }
  figcaption { margin-top: 0.75rem; font-size: 0.85rem; color: var(--ink-dim); }
</style>
