---
import { site } from '../site.config';
---

<header class="site-header wrap">
  <a class="mark" href="/">{site.name}</a>
  <nav aria-label="Primary">
    <ul class="mono">
      <li><a href="/#work">Projects</a></li>
      <li><a href="/#about">About</a></li>
      <li><a href="/#contact">Contact</a></li>
      <li><a href={site.github}>GitHub</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem;
    font-size: 0.8rem;
  }
  .mark { color: var(--ink); text-decoration: none; font-family: var(--font-display); font-size: 1.05rem; font-weight: 560; }
  nav { display: flex; gap: 2rem; flex-wrap: wrap; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }
  nav a, .mark { display: inline-block; padding-block: 0.4rem; }
  nav a { color: var(--ink-dim); text-decoration: none; }
  nav a:hover { color: var(--ink); }
</style>
