---
import { site } from '../site.config';
import HeroTrace from './HeroTrace.astro';
interface Props { intro: string }
const { intro } = Astro.props;
---

<section class="hero wrap" aria-labelledby="hero-title" data-section="hero">
  <p class="meta">{site.role} · neurotech and software</p>
  <h1 id="hero-title">{site.name}</h1>
  <p class="thesis">{site.thesis}</p>
  <p class="intro col dim">{intro}</p>
  <HeroTrace />
  <p class="next meta">
    <a href="#demo">Hold to contract: a classifier that drifts and recovers, in your browser ↓</a>
  </p>
</section>

<style>
  .hero { padding-block: clamp(3rem, 2rem + 6vw, 7rem) 3rem; }
  h1 { margin-top: 1rem; }
  .thesis {
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.6rem);
    line-height: 1.15;
    font-style: italic;
    font-weight: 380;
    color: var(--bone);
    max-width: 22ch;
    margin: 1rem 0 1.75rem;
  }
  .intro { margin-bottom: 3rem; }
  .next { margin-top: 2.5rem; }
</style>
